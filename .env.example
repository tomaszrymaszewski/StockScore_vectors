# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Polygon.io -- historical price data (jobs/fetch_prices.py).
POLYGON_API_KEY=your_polygon_key_here

# Only needed for the LEGACY Pinecone-backed scripts (test_gics.py,
# generate_sector_composites.py, generate_quarterly_vectors.py, market_dislocation.py).
# The research benchmark in benchmark/ does NOT use Pinecone.
PINECONE_API_KEY=your_pinecone_key_here
